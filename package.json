{
  "name": "luogu-discuss-saver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "洛谷讨论帖存档：Cloudflare Pages（静态前端 + Pages Functions 读 API）+ 后台 Worker（Cron + Queue + Durable Objects）+ D1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json",
    "deploy": "npm run deploy:pages",
    "deploy:pages": "npm run build && wrangler pages deploy dist",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --persist-to .wrangler/state",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply luogu-discuss --local",
    "db:migrate:remote": "wrangler d1 migrations apply luogu-discuss --remote"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-orm": "^0.44.7",
    "highlight.js": "^11.12.0",
    "hono": "^4.6.14",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
